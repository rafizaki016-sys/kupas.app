# URL Produksi (isi setelah deploy ke Vercel)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Auth, Postgres + pgvector, Storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# AI Komunitas (Gemini API gratis dari aistudio.google.com)
# Pelajar juga bisa memakai kunci gratis milik mereka sendiri lewat mode BYOK di Pengaturan
GOOGLE_GENERATIVE_AI_API_KEY=

# Opsional: Email transaksional (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
